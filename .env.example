# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
# Clave de service role: bypassea RLS. El backend la requiere para arrancar (falla el boot si falta).
# NUNCA exponerla en un cliente (móvil/web) ni loguearla.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase

# Mercado Pago
# Use PROD keys para producción, o TEST-/APP_USR- de una cuenta vendedor de prueba para testing
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxx

# Admin
# Emails con acceso admin (fallback si el JWT no trae app_metadata.role/roles = admin), separados por coma
ADMIN_EMAILS=admin@certifix.com
# Bypass de desarrollo del AdminGuard: NUNCA setear en producción (el guard además lo ignora si NODE_ENV=production).
# Dejar sin definir salvo que estés debuggeando el panel admin en local.
ADMIN_BYPASS=false

# Storage
EVIDENCIAS_BUCKET=evidencias

# App Config
PORT=3000
NODE_ENV=production
WEBHOOK_URL=https://tu-app-en-render.onrender.com
# Orígenes permitidos por CORS, separados por coma (sin espacios). Ej: https://app.certifix.com,https://admin.certifix.com
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3001
